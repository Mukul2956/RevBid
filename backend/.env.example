# Copy to `.env` for local development. Every value has a safe local default; production
# requires JWT_SECRET and COOKIE_SECURE (the app refuses to start otherwise).

ENV=local                       # local | test | production
LOG_LEVEL=INFO

# Host ports 5433 / 6380 avoid clashing with a Postgres/Redis already running on the default ports.
DATABASE_URL=postgresql+asyncpg://auction:auction@127.0.0.1:5433/auction
REDIS_URL=redis://127.0.0.1:6380/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789
COOKIE_SECURE=false
COOKIE_SAMESITE=lax             # lax | strict | none (none requires COOKIE_SECURE=true)
CORS_ORIGINS=["http://localhost:5173"]
WS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Optional: require `Authorization: Bearer <token>` on /metrics
# METRICS_TOKEN=
# Optional: error tracking
# SENTRY_DSN=

# Background scheduler (set false on all but one process if you split it out)
RUN_SCHEDULER=true

# Keep a few auctions open automatically so there is always something live (demo/review)
DEMO_MODE=true

# Seed passwords used by `python -m scripts.seed`
SEED_ADMIN_PASSWORD=Admin@12345
SEED_BUYER_PASSWORD=Buyer@12345
