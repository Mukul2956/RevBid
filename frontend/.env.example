# Public build-time configuration (baked into the bundle: never put secrets here).
# WebSocket endpoint. Dev default: ws://<host>:8100/ws. Production: wss://<render-api-host>/ws
# VITE_WS_URL=wss://revbid-api.onrender.com/ws

# Show the demo accounts card on the login page (set false for a real deployment).
VITE_SHOW_DEMO_CREDENTIALS=true
# VITE_DEMO_BUYER_PASSWORD=Buyer@12345
# VITE_DEMO_ADMIN_PASSWORD=Admin@12345
